          "isConsentEmail",
          "lineItems",
          "mode",
          "originPortCode",
          "pickupType",
          "ratingType",
          "weightUom"
        ]
      },
      "ApiError": {
        "type": "object",
        "description": "RFC 9457 problem detail. Field level failures add errors.",
        "properties": {
          "type": {
            "type": "string",
            "example": "about:blank"
          },
          "title": {
            "type": "string",
            "example": "Bad Request"
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "example": 400
          },
          "detail": {
            "type": "string",
            "example": "The request body has 2 validation error(s)."
          },
          "instance": {
            "type": "string",
            "example": "/api/v1/quote-requests"
          },
          "errors": {
            "type": "array",
            "description": "One entry per rejected field. Absent when no field was at fault.",
            "items": {
              "$ref": "#/components/schemas/ApiFieldError"
            }
          }
        }
      },
      "ApiFieldError": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "example": "lineItems[0].packageType"
          },
          "message": {
            "type": "string",
            "example": "'BOX' is not an active code. Expected a cdcode from category PKT."
          }
        }
      },
      "QuoteRequestCreated": {
        "type": "object",
        "properties": {
          "qrid": {
            "type": "integer",
            "format": "int64",
            "description": "Primary key of the stored request.",
            "example": 1045
          },
          "qrref": {
            "type": "string",
            "description": "Business reference to show the user.",
            "example": "QR-2026-001045"
          },
          "status": {
            "type": "string",
            "description": "Always RQSNEW on create. Its label comes from category RQS.",
            "example": "RQSNEW"
          }
        }
      },
      "PingResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "QuoteDefaults": {
        "type": "object",
        "properties": {
          "version": {
            "type": "integer",
            "format": "int32",
            "description": "Goes up whenever a value below changes. Compare it to decide whether a cached copy is stale.",
            "example": 1
          },
          "mode": {
            "type": "string",
            "description": "Category TPM.",
            "example": "TPMA"
          },
          "cargoType": {
            "type": "string",
            "description": "Category CGT.",
            "example": "CGTPNP"
          },
          "ratingType": {
