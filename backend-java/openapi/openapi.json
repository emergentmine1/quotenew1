            "minLength": 0
          },
          "pickupAddress1": {
            "type": "string",
            "maxLength": 200,
            "minLength": 0
          },
          "pickupAddress2": {
            "type": "string",
            "maxLength": 200,
            "minLength": 0
          },
          "pickupCity": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          },
          "pickupState": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          },
          "pickupPostalCode": {
            "type": "string",
            "maxLength": 20,
            "minLength": 0
          },
          "pickupCountryCode": {
            "type": "string",
            "maxLength": 3,
            "minLength": 0
          },
          "deliveryType": {
            "type": "string",
            "maxLength": 20,
            "minLength": 0
          },
          "destinationPortCode": {
            "type": "string",
            "maxLength": 3,
            "minLength": 0
          },
          "deliveryAddress1": {
            "type": "string",
            "maxLength": 200,
            "minLength": 0
          },
          "deliveryAddress2": {
            "type": "string",
            "maxLength": 200,
            "minLength": 0
          },
          "deliveryCity": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          },
          "deliveryState": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          },
          "deliveryPostalCode": {
            "type": "string",
            "maxLength": 20,
            "minLength": 0
          },
          "deliveryCountryCode": {
            "type": "string",
            "maxLength": 3,
            "minLength": 0
          },
          "weightUom": {
            "type": "string",
            "maxLength": 20,
            "minLength": 0
          },
          "dimensionUom": {
            "type": "string",
            "maxLength": 20,
            "minLength": 0
          },
          "totalGrossWeight": {
            "type": "number",
            "minimum": 0
          },
          "totalGrossWeightUom": {
            "type": "string",
            "maxLength": 20,
            "minLength": 0
          },
          "totalVolume": {
            "type": "number",
            "minimum": 0
          },
          "totalVolumeUom": {
            "type": "string",
            "maxLength": 20,
            "minLength": 0
          },
          "totalVolumeWeight": {
            "type": "number",
            "minimum": 0
          },
          "totalVolumeWeightUom": {
            "type": "string",
            "maxLength": 20,
            "minLength": 0
          },
          "totalChargeableWeight": {
            "type": "number",
            "minimum": 0
          },
          "totalChargeableWeightUom": {
            "type": "string",
            "maxLength": 20,
            "minLength": 0
          },
          "cargoReadyDate": {
            "type": "string",
            "format": "date-time"
          },
          "cargoReadyTz": {
            "type": "string",
            "maxLength": 5,
            "minLength": 0
          },
          "cargoReadyTzStd": {
            "type": "string",
            "maxLength": 50,
            "minLength": 0
          },
          "requiredDeliveryDate": {
            "type": "string",
            "format": "date-time"
          },
          "requiredDeliveryTz": {
            "type": "string",
            "maxLength": 5,
            "minLength": 0
          },
          "requiredDeliveryTzStd": {
            "type": "string",
            "maxLength": 50,
            "minLength": 0
          },
          "fullName": {
            "type": "string",
            "maxLength": 120,
            "minLength": 0
          },
          "companyName": {
            "type": "string",
            "maxLength": 200,
