          },
          "cargoType": {
            "type": "string",
            "maxLength": 20,
            "minLength": 0
          },
          "ratingType": {
            "type": "string",
            "maxLength": 20,
            "minLength": 0
          },
          "pickupType": {
            "type": "string",
            "maxLength": 20,
            "minLength": 0
          },
          "originPortCode": {
            "type": "string",
