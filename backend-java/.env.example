# Copy to .env and fill in. .env is git ignored and must never be committed.
# Spring reads these from the process environment, not from this file.
# Set them in your shell or in your IDE run configuration.
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_SCHEMA=quoteownr
DB_USER=
DB_PASSWORD=
SERVER_PORT=8080

# Optional. Remove the # to use one. An empty value would override the default, so leave
# unused lines commented out. Without the mail settings no email is sent, and without
# LOCATION_API_KEY there are no city or zip code suggestions.
# LOG_LEVEL=INFO
# SPRING_MAIL_HOST=email-smtp.us-east-1.amazonaws.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# MAIL_STARTTLS_REQUIRED=true
# MAIL_FROM=
# MAIL_INTERNAL_TO=
# LOCATION_API_KEY=
# AWS_REGION=us-east-1
